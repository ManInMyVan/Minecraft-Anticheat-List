{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anticheat",
  "description": "Schema for anticheat entries.",
  "type": "object",
  "required": ["platform", "status", "versions", "price"],
  "properties": {
    "platform": {
      "type": ["string", "array"],
      "default": "Unknown",
      "anyOf": [
        {
          "$ref": "#/$defs/multiple-platforms"
        },
        {
          "const": "Unknown"
        }
      ]
    },
    "status": {
      "type": ["string", "null"],
      "default": "Unknown",
      "enum": ["Active", "Inactive", "Discontinued", "Unknown", "Old", "Unavailable", null]
    },
    "versions": {
      "type": "string",
      "default": "Unknown",
      "minLength": 1
    },
    "spigot": {
      "type": ["integer", "null"],
      "default": null
    },
    "github": {
      "type": ["string", "null"],
      "default": null,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "price": {
      "type": "string",
      "anyOf": [
        {},
        {
          "const": "Free"
        }
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": ["string", "null"],
            "anyOf": [
              {},
              {
                "enum": [
                  "GitHub",
                  "SpigotMC",
                  "Bukkit",
                  "BuiltByBit",
                  "Discord",
                  "Dedicated Site",
                  "BStats",
                  "Hangar",
                  "Polymart"
                ]
              }
            ]
          },
          "url": {
            "$ref": "#/$defs/url"
          }
        },
        "required": ["name", "url"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "single-platform": {
      "type": "string",
      "enum": [
        "Bukkit",
        "Sponge",
        "Skript",
        "Minestom",
        "Datapack",
        "Fabric",
        "Forge"
      ]
    },
    "multiple-platforms": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/single-platform"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        {
          "$ref": "#/$defs/single-platform"
        }
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://.*$"
    }
  }
}